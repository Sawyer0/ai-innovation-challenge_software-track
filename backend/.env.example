# Copy to backend/.env and fill in at least one AI key. backend/.env is gitignored;
# never commit real keys. Placeholder values below are treated as "not set".

# --- AI providers (tried in this order; configure one or more) ---
ANTHROPIC_API_KEY=sk-ant-...        # Claude (paid)
GEMINI_API_KEY=...                  # Google Gemini (free tier available)
GROQ_API_KEY=gsk_...                # Groq (free tier): https://console.groq.com/keys

# --- AI models (optional, defaults shown) ---
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b  # used for image transcripts

# --- Database (optional, defaults shown) ---
DATABASE_URL=sqlite:///./bmcc_catalog.db

# --- Server (optional, defaults shown) ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
